# OpenRouter — required for the AI Assistant
OPENROUTER_API_KEY=sk-or-v1-...

# Optional override (default: openai/gpt-5)
# OPENROUTER_MODEL=openai/gpt-5

# Max completion tokens sent to OpenRouter as max_tokens (default: 2048 — room for SVG edits)
# OPENROUTER_MAX_TOKENS=2048

# Approx input token budget for chat history; oldest messages drop first (default: 4000)
# OPENROUTER_MAX_INPUT_TOKENS=4000

# Optional site URL for OpenRouter rankings
# OPENROUTER_SITE_URL=http://localhost:3000

# PostHog — project token from Project Settings (enable Session replay there too)
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# EU cloud instead:
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# AI safety — set to false for an emergency kill switch
# AI_ENABLED=true
# Max tool/model rounds per AI request (1–8, default 5)
# AI_MAX_STEPS=5

# Cloudflare Turnstile — first AI request per IP must pass CAPTCHA
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
